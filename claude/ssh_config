# SSH config for the agent identity's git remotes, reached via core.sshCommand in
# ~/.claude/gitconfig. Nothing else uses it.
#
# github.com is served entirely from the block below and is deliberately excluded
# from the Include. `IdentityFile` is additive and `IdentitiesOnly yes` does not help
# -- a file appended by an included `Host github.com` block counts as configured, so
# a personal key would be offered too, and would push as the human account the moment
# claude-auth stopped answering first. An identity that is supposed to be separately
# revocable cannot have a silent fallback to the identity it is separate from. The
# cost is that a github-specific workaround in ~/.ssh/config (the ssh.github.com:443
# port escape, say) does not apply here; add it to this block if you ever need it.
Host github.com
	HostName github.com
	User git
	IdentityAgent ~/.claude/run/agent.sock
	IdentityFile ~/.claude/claude-auth.pub
	IdentitiesOnly yes

# Every other host comes from the personal config unchanged. `Match !host` rather than
# a bare Include: an Include at the end of a `Host` block is CONDITIONAL on that block,
# so writing it there would leave every non-github remote with no ~/.ssh/config at all
# -- no ProxyJump, no User, no IdentityFile.
Match !host github.com
Include ~/.ssh/config
