#!/bin/sh
# Load the agent git identity into a long-lived ssh-agent, from 1Password, without
# ever writing a private key to disk.
#
# Not the 1Password SSH agent: that one prompts for approval, and signing and SSH
# auth both go through the desktop app, so they fail together and intermittently
# ("failed to fill whole buffer"). This is plain OpenSSH, holds only these two keys,
# and keeps them in its own memory. `op read` streams each key into `ssh-add -`.
#
# Idempotent: adopts a healthy agent and reloads only when a key is missing.
set -eu

# Every command below is resolved through PATH, and a repository's .claude/settings.json
# can set PATH for the SessionStart hook this runs from. A repository-supplied `ssh-add`
# would be handed both 1Password private keys on stdin -- the keys never touch disk, but
# that is no help if the process reading them is the attacker's. System directories
# first, then the one directory `op` was found in at install time.
PATH="/usr/bin:/bin:/usr/sbin:/sbin:@OP_DIR@"
export PATH

# Fixed, not configurable. An override was attacker-controllable -- this runs from a
# SessionStart hook and a repository's own .claude/settings.json outranks the user's --
# and ~/.claude/ssh_config could not honour it anyway, so a session could have signed
# commits against one agent while every push looked for another. One path, named in
# one place, is the only version of this that cannot disagree with itself.
SOCK="$HOME/.claude/run/agent.sock"

# A leftover regular file here would otherwise be chmodded and unlinked on the way to
# creating the socket.
if [ -e "$SOCK" ] && [ ! -S "$SOCK" ]; then
  echo "claude-ssh-agent: $SOCK exists and is not a socket; refusing to replace it" >&2
  exit 1
fi

# Substituted by install.sh, not read at runtime. A repository can set the environment
# for the hook this runs from, and would otherwise redirect these op read calls at
# identically named items in another vault it can reach -- whose keys then sit in the
# agent at a socket path it knows. It also has to be baked to work at all: installing
# with CLAUDE_OP_VAULT=Work writes Work's public keys, and a later session without that
# variable exported would look in Private and fail every commit and push.
VAULT="@OP_VAULT@"
# By title, not by item id: readable, and it survives an item being recreated.
SIGNING="op://$VAULT/claude-signing/private key?ssh-format=openssh"
AUTH="op://$VAULT/claude-auth/private key?ssh-format=openssh"

# Reuse the agent only when it holds the keys we actually want, by fingerprint.
# Counting them is not enough: after either 1Password item is rotated the agent still
# holds two keys -- the old ones -- so a count check would report success while every
# commit and push fails against the revoked pair. The public halves are written by
# install.sh, so this costs no 1Password call on the common path.
holds_expected_keys() {
  [ -S "$SOCK" ] || return 1
  SSH_AUTH_SOCK="$SOCK" ssh-add -l >/dev/null 2>&1 || return 1
  loaded="$(SSH_AUTH_SOCK="$SOCK" ssh-add -l | awk '{print $2}')"
  for pub in "$HOME/.claude/claude-signing.pub" "$HOME/.claude/claude-auth.pub"; do
    # An expected key we cannot name cannot be checked; rebuild rather than assume.
    [ -f "$pub" ] || return 1
    want="$(ssh-keygen -lf "$pub" 2>/dev/null | awk '{print $2}')"
    [ -n "$want" ] || return 1
    printf '%s\n' "$loaded" | grep -qxF "$want" || return 1
  done
  return 0
}

if holds_expected_keys; then
  echo "claude-ssh-agent: already loaded at $SOCK"
  exit 0
fi

# Rebuilding the agent is not safe to run concurrently. Several sessions opening at
# once each found no agent, and each ran `rm -f "$SOCK"; ssh-agent -a "$SOCK"` -- so N
# simultaneous starts left N agents, every one holding both private keys in memory,
# and only the last one still reachable through the socket. The rest were unkillable
# by any later run and lived until reboot.
#
# The kernel holds the lock, not a file's existence: lockf(1) takes a BSD flock on fd 9
# and the kernel drops it when this process ends, however it ends. A lock that has to be
# judged abandoned and broken by hand cannot be made correct in POSIX sh -- inspecting it
# and breaking it are two steps, so a run delayed between them breaks the lock of whoever
# acquired it in between, and both rebuild. There is no state here to judge.
LOCK="$HOME/.claude/run/agent.lock"
mkdir -p "$(dirname "$SOCK")"
chmod 700 "$(dirname "$SOCK")"
exec 9>"$LOCK"
# Wait rather than skip the load: a session that gave up has no agent at all, so every
# commit and push in it would fail. 20s stays inside the SessionStart hook's 30s budget.
if ! lockf -s -t 20 9; then
  echo "claude-ssh-agent: another run held $LOCK for 20s; giving up" >&2
  exit 1
fi

# The run that held the lock may have done this run's work already. Re-checking here is
# what keeps a burst of sessions down to one rebuild and one pair of 1Password reads.
if holds_expected_keys; then
  echo "claude-ssh-agent: already loaded at $SOCK"
  exit 0
fi

command -v op >/dev/null 2>&1 || { echo "claude-ssh-agent: the 1Password CLI (op) is required" >&2; exit 1; }

# A session may carry OP_SERVICE_ACCOUNT_TOKEN, and op prefers it over the personal
# login. A 1Password service account cannot be granted access to a PERSONAL vault, so
# with the token set these keys become unreadable however well the token works for
# everything else -- and `op whoami` still succeeds, so the guard above cannot catch it.
# Read with whatever the environment provides, then retry without the token.
op_read() {
  op read "$1" 2>/dev/null && return 0
  [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] || return 1
  env -u OP_SERVICE_ACCOUNT_TOKEN op read "$1" 2>/dev/null
}

op_read "$SIGNING" >/dev/null 2>&1 ||
  { echo "claude-ssh-agent: cannot read $SIGNING — is op signed in, and does that identity have the vault?" >&2; exit 1; }

# Take down whatever was behind this path before starting a replacement. `rm -f` alone
# only unlinks the socket: the agent keeps running with both keys in memory, reachable
# by nothing and killable by no later run. Matching the full command line is also what
# reaps agents orphaned by earlier versions of this script.
#
# Signalling is not enough on its own, because it does not wait. An ssh-agent handles
# SIGTERM by unlinking its socket path -- this very path -- so one that had not been
# scheduled yet by the time the replacement bound would delete the new socket, leaving
# the session with an agent nothing can reach. Wait for them to actually be gone.
olds="$(pgrep -f "ssh-agent -a $SOCK" 2>/dev/null || true)"
if [ -n "$olds" ]; then
  kill $olds 2>/dev/null || true
  waits=0
  while [ "$waits" -lt 50 ]; do
    still=""
    for pid in $olds; do
      if kill -0 "$pid" 2>/dev/null; then still="$still $pid"; fi
    done
    [ -n "$still" ] || break
    sleep 0.1
    waits=$((waits + 1))
  done
  # Anything alive after five seconds is not going to act on the signal. SIGKILL leaves
  # it no handler to run, so it cannot unlink the path about to be rebound either.
  for pid in $olds; do
    if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid" 2>/dev/null || true; fi
  done
fi
rm -f "$SOCK"
# 9>&- closes the lock descriptor for the agent. A BSD flock lives as long as any
# descriptor on the open file, and the agent is meant to stay up indefinitely -- inherit
# the fd and it holds this lock forever, so every later session waits the full timeout
# and then starts with no agent at all.
ssh-agent -a "$SOCK" 9>&- >/dev/null

# `op read` emits no trailing newline and ssh-add needs one; the default field is
# PKCS#8, which ssh-add rejects, hence ssh-format=openssh above.
for item in "$SIGNING" "$AUTH"; do
  printf '%s\n' "$(op_read "$item")" | SSH_AUTH_SOCK="$SOCK" ssh-add - >/dev/null 2>&1 ||
    { echo "claude-ssh-agent: could not load $item" >&2; exit 1; }
done
echo "claude-ssh-agent: loaded $(SSH_AUTH_SOCK="$SOCK" ssh-add -l | wc -l | tr -d ' ') keys into $SOCK"
